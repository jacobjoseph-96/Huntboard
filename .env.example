# Optional free API keys for more job boards. Copy this file to .env and fill in what you have.
# Huntboard works without them; the boards that need a key are simply skipped.

# Adzuna (19 countries): https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble (many countries): https://jooble.org/api/about
JOOBLE_KEY=
